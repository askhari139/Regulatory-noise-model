\@writefile{toc}{\contentsline {subsection}{\numberline {3.8}Effects of regulatory noise on the phenotypic landscape scale to larger biological networks}{23}{subsection.3.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Regulatory noise in large-network Boolean models.} All perturbed simulations use the ODE-equivalent threshold rule (Eq.~\ref {eq:boolbias}). A) Phenotypic-score trajectories (100 of 1000) for the EMT (i) and gonadal (ii) networks under additive noise, $\sigma = 0.05$, coloured by the phenotype of the initial state; thick lines, mean. B) Team-score density for the EMT network: steady states of the unperturbed network (WT) and the trajectories in A (additive noise), from low (blue) to high (yellow) frequency. C) Fraction of time spent at each phenotypic score under additive noise, mean and interquartile range over 1000 trajectories, for (i) EMT and (ii) gonadal networks; $\sigma = 0$ is the steady-state distribution of the unperturbed network. D) Fraction of time in mixed states ($|\text  {phenotypic score}| \le 0.5$) against $\sigma $ under additive noise, for stochastic weights, frozen weights drawn from the same time-pooled distribution, and the standard threshold rule without the ODE-equivalent threshold. Stationary noise is shown in Figure~\ref {fig:7S2}.}}{24}{figure.caption.7}\protected@file@percent }
\newlabel{fig:7}{{7}{24}{\textbf {Regulatory noise in large-network Boolean models.} All perturbed simulations use the ODE-equivalent threshold rule (Eq.~\ref {eq:boolbias}). A) Phenotypic-score trajectories (100 of 1000) for the EMT (i) and gonadal (ii) networks under additive noise, $\sigma = 0.05$, coloured by the phenotype of the initial state; thick lines, mean. B) Team-score density for the EMT network: steady states of the unperturbed network (WT) and the trajectories in A (additive noise), from low (blue) to high (yellow) frequency. C) Fraction of time spent at each phenotypic score under additive noise, mean and interquartile range over 1000 trajectories, for (i) EMT and (ii) gonadal networks; $\sigma = 0$ is the steady-state distribution of the unperturbed network. D) Fraction of time in mixed states ($|\text {phenotypic score}| \le 0.5$) against $\sigma $ under additive noise, for stochastic weights, frozen weights drawn from the same time-pooled distribution, and the standard threshold rule without the ODE-equivalent threshold. Stationary noise is shown in Figure~\ref {fig:7S2}}{figure.caption.7}{}}
