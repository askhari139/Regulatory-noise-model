\@writefile{toc}{\contentsline {subsection}{\numberline {2.5}Multiplicative noise drives the phenotypic landscape toward single-high states - an opposite effect as that of additive noise}{12}{subsection.2.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Effect of multiplicative noise on the phenotypic landscape of cell-fate decision networks. \textbf  {(A)} MRT vs.\ noise level for the TTSA network, single-high and double-high states; grey lines show a random sample of 100 parameter-set trajectories, with the mean across the full parameter population shown separately. \textbf  {(B)} Average MRT of single-high vs.\ double-high states vs.\ noise level, for TS, TSSA, TT, and TTSA. \textbf  {(C)} Same, for the 4-node networks TT4 and TS4. \textbf  {(D)} Stochastic effect (as in Fig.\ 4C(i)) for the single-high state, across noise levels, for TS, TSSA, TT, TTSA, TT4, and TT4SA. }}{13}{figure.caption.5}\protected@file@percent }
\newlabel{fig:4}{{5}{13}{Effect of multiplicative noise on the phenotypic landscape of cell-fate decision networks. \textbf {(A)} MRT vs.\ noise level for the TTSA network, single-high and double-high states; grey lines show a random sample of 100 parameter-set trajectories, with the mean across the full parameter population shown separately. \textbf {(B)} Average MRT of single-high vs.\ double-high states vs.\ noise level, for TS, TSSA, TT, and TTSA. \textbf {(C)} Same, for the 4-node networks TT4 and TS4. \textbf {(D)} Stochastic effect (as in Fig.\ 4C(i)) for the single-high state, across noise levels, for TS, TSSA, TT, TTSA, TT4, and TT4SA}{figure.caption.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.6}Multistable double-high states resolve toward their nearest single-high fate, and this generalizes across networks}{14}{subsection.2.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {MRT-based multistability and transition analysis for the TT4 network.} \textbf  {(A)} Distribution of switching-event counts by noise level (Additive vs.\ Multiplicative), after excluding the initial burn-in window. \textbf  {(B)} Frequency of the three deterministic stability classes among double-high parameter sets. \textbf  {(C)} For each stability class, the fraction of parameter sets accessing 1 (Monostable), 2 (Bistable), or 3+ (Tristable/Tetrastable) distinct single-high fates under noise. \textbf  {(D)} Circular chord diagram of double-high $\to $ single-high MRT flow among monostable double-high parameter sets, at noise = 0.01. \textbf  {(E)} Noise-level $\to $ outcome alluvial for the pooled monostable double-high population (outcomes labeled relative to the initial double-high state XY, e.g.\ ``XY to X''), colored by the multistability classification from panel C. }}{15}{figure.caption.6}\protected@file@percent }
\newlabel{fig:6}{{6}{15}{\textbf {MRT-based multistability and transition analysis for the TT4 network.} \textbf {(A)} Distribution of switching-event counts by noise level (Additive vs.\ Multiplicative), after excluding the initial burn-in window. \textbf {(B)} Frequency of the three deterministic stability classes among double-high parameter sets. \textbf {(C)} For each stability class, the fraction of parameter sets accessing 1 (Monostable), 2 (Bistable), or 3+ (Tristable/Tetrastable) distinct single-high fates under noise. \textbf {(D)} Circular chord diagram of double-high $\to $ single-high MRT flow among monostable double-high parameter sets, at noise = 0.01. \textbf {(E)} Noise-level $\to $ outcome alluvial for the pooled monostable double-high population (outcomes labeled relative to the initial double-high state XY, e.g.\ ``XY to X''), colored by the multistability classification from panel C}{figure.caption.6}{}}
